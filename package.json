{
  "name": "skok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based Active Arcade clone: body tracking mini-games (MediaPipe Pose Landmarker + React + Canvas 2D)",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "cap:sync": "npm run build && cap sync android",
    "cap:android": "npm run build && cap sync android && cap open android",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:install": "npm run android:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:shot": "node scripts/android-shot.mjs",
    "cat:preview": "node scripts/cat-preview.mjs",
    "android:run": "npm run android:install && adb shell am start -n com.skok.arcade/.MainActivity",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "check:camera": "node scripts/camera-check.mjs",
    "check:pose": "node scripts/pose-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@mediapipe/tasks-vision": "^0.10.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
